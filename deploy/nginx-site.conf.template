limit_req_zone $binary_remote_addr zone=oyla_api:10m rate=20r/s;
map $sent_http_content_type $oyla_html_cache_control {
  default "";
  ~^text/html "no-store";
}
server {
  listen 80;
  server_name DOMAIN;
  location /.well-known/acme-challenge/ { root /var/www/letsencrypt; }
  location / { return 301 https://$host$request_uri; }
}
server {
  listen 443 ssl;
  server_name DOMAIN;
  ssl_certificate CERT_DIRECTORY/fullchain.pem;
  ssl_certificate_key CERT_DIRECTORY/privkey.pem;
  include /etc/letsencrypt/options-ssl-nginx.conf;
  ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
  server_tokens off;
  client_max_body_size 256k;
  add_header Strict-Transport-Security "max-age=31536000" always;
  location /api/ {
    limit_req zone=oyla_api burst=40 nodelay;
    proxy_pass http://127.0.0.1:3001;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
  }
  location / {
    add_header Cache-Control $oyla_html_cache_control always;
    add_header Strict-Transport-Security "max-age=31536000" always;
    proxy_pass http://127.0.0.1:8080;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
  }
}
